# --- Frontend (Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Edge Function `ingest-telemetry` (server-side only) ---
# KHÔNG đặt các giá trị này vào Vite/frontend. Nạp qua:
#   supabase secrets set INGEST_SHARED_SECRET=...
# SUPABASE_URL và SUPABASE_SERVICE_ROLE_KEY được nền tảng Supabase nạp tự động.
# INGEST_SHARED_SECRET: chuỗi bí mật khớp header Authorization của AWS IoT Rule.
