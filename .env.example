# --- Frontend (Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Khoá VAPID CÔNG KHAI cho thông báo đẩy (Cài đặt → Thông báo).
# Sinh bằng: node tools/vapid-keys.mjs — script in ra cả khoá này lẫn
# lệnh nạp khoá riêng vào Supabase secrets. Bỏ trống thì công tắc "Thông báo
# đẩy" hiện mờ kèm ghi chú chưa cấu hình, phần còn lại của app không đổi.
VITE_VAPID_PUBLIC_KEY=

# --- Edge Function `ingest-telemetry` (server-side only) ---
# KHÔNG đặt các giá trị này vào Vite/frontend. Nạp qua:
#   supabase secrets set INGEST_SHARED_SECRET=...
# SUPABASE_URL và SUPABASE_SERVICE_ROLE_KEY được nền tảng Supabase nạp tự động.
# INGEST_SHARED_SECRET: chuỗi bí mật khớp header Authorization của AWS IoT Rule.

# --- Edge Function `send-push` (server-side only) ---
#   supabase secrets set VAPID_KEYS='{"publicKey":{...},"privateKey":{...}}'
#   supabase secrets set VAPID_SUBJECT=mailto:ban@email.com
#   supabase secrets set MAINTENANCE_SHARED_SECRET=...   (dùng chung với 0019)
# VAPID_KEYS chứa khoá RIÊNG — không bao giờ đặt vào .env của Vite.
